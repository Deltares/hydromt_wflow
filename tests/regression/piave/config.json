{
  "sbm": {
    "build_config": "tests/regression/piave/build_sbm.yml",
    "data_catalogs": [
      "examples/data/demand/data_catalog.yml",
      "hydromt_wflow/data/parameters_data.yml",
      "artifact_data",
      "deltares_data"
    ],
    "config_toml": "wflow_sbm.toml",
    "output_nc": "run_default/output.nc",
    "metrics": [
      {
        "name": "outlet_discharge",
        "variable": "river_q",
        "selector": { "lat": 45.8331, "lon": 12.2051 },
        "selector_method": "sel",
        "aggregation": "mean",
        "metrics": ["mean", "peak", "total"],
        "rel_tol": 0.01,
        "abs_tol": 1e-06
      }
    ]
  },
  "sediment": {
    "build_config": "tests/regression/piave/build_sediment.yml",
    "data_catalogs": [
      "examples/data/demand/data_catalog.yml",
      "hydromt_wflow/data/parameters_data.yml",
      "artifact_data",
      "deltares_data"
    ],
    "config_toml": "wflow_sediment.toml",
    "output_nc": "run_default_sediment/output.nc",
    "metrics": [
      {
        "name": "soil_loss_sum",
        "variable": "soil_loss",
        "aggregation": "sum",
        "metrics": ["mean", "peak", "total"],
        "rel_tol": 0.01,
        "abs_tol": 1e-06
      },
      {
        "name": "soil_loss_mean",
        "variable": "soil_loss",
        "aggregation": "mean",
        "metrics": ["mean", "peak", "total"],
        "rel_tol": 0.01,
        "abs_tol": 1e-06
      },
      {
        "name": "suspended_solids_sum",
        "variable": "suspended_solids",
        "aggregation": "sum",
        "metrics": ["mean", "peak", "total"],
        "rel_tol": 0.01,
        "abs_tol": 1e-06
      },
      {
        "name": "suspended_solids_mean",
        "variable": "suspended_solids",
        "aggregation": "mean",
        "metrics": ["mean", "peak", "total"],
        "rel_tol": 0.01,
        "abs_tol": 1e-06
      }
    ]
  },
  "baseline_metrics": "tests/regression/piave/metrics/baseline_metrics.json"
}
